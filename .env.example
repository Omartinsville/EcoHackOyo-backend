# Copy to .env and fill in real values. Never commit the real .env file.

# Full connection string from your managed Postgres provider (Neon, Supabase,
# Railway, RDS...). Use the POOLED connection string if your provider offers
# one (Neon and Supabase both do) — see backend/README.md.
DATABASE_URL=postgresql://neondb_owner:npg_9pql2CeZLROJ@ep-cool-sky-azm75dxh-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Comma-separated list of origins allowed to call this API (your live site).
ALLOWED_ORIGIN=http://localhost:5500, http://172.28.112.1:5500, https://impending-stoppage-harbor.ngrok-free.dev, https://ecohackoyo.netlify.app


# Max local pg pool connections. Keep small — see server.js comment.
PG_POOL_MAX=8

PORT=3000
# WhatsApp group invite links. Returned in the registration API response so
# the frontend can redirect a successful registrant straight there.
# Get these from WhatsApp: group > Invite via link > Copy link.
# Leave a value blank/unset to skip the redirect for that form (e.g. if you
# haven't created the group yet) — the success page still shows normally.
WHATSAPP_HACKATHON_LINK=https://chat.whatsapp.com/L0C1dflR3S9GiGYoM0evkr
WHATSAPP_SUMMIT_LINK=https://chat.whatsapp.com/REPLACE_WITH_WHEN_CALLED

